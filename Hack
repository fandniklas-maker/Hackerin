-- Players Tab
local PlayerTab = Window:CreateTab("Players", 4483362458)

local SelectedPlayer = ""
local PlayerDropdown = PlayerTab:CreateDropdown({
   Name = "Select Player",
   Options = {},
   CurrentOption = "",
   MultipleOptions = false,
   Flag = "PlayerDropdown",
   Callback = function(Option)
      SelectedPlayer = Option[1]
   end,
})

-- Function to refresh player list
local function updatePlayerList()
    local pList = {}
    for _, v in pairs(Players:GetPlayers()) do
        if v.Name ~= LocalPlayer.Name then
            table.insert(pList, v.Name)
        end
    end
    PlayerDropdown:Refresh(pList, true)
end

PlayerTab:CreateButton({
   Name = "Refresh Player List",
   Callback = function()
      updatePlayerList()
   end,
})

PlayerTab:CreateButton({
   Name = "Teleport To Player",
   Callback = function()
      local target = Players:FindFirstChild(SelectedPlayer)
      if target and target.Character then
          LocalPlayer.Character.HumanoidRootPart.CFrame = target.Character.HumanoidRootPart.CFrame
      end
   end,
})

PlayerTab:CreateButton({
   Name = "Bring Player (Requires Tool/FE Bypass)",
   Callback = function()
      -- Note: Bringing players in FilteringEnabled (FE) games is restricted.
      -- This script attempts a standard CFrame move which usually only works if you have network ownership.
      local target = Players:FindFirstChild(SelectedPlayer)
      if target and target.Character then
          target.Character.HumanoidRootPart.CFrame = LocalPlayer.Character.HumanoidRootPart.CFrame
          Rayfield:Notify({
             Title = "Bring Attempted",
             Content = "Attempted to bring " .. SelectedPlayer .. ". Note: May not work in all games due to FE.",
             Duration = 5,
             Image = 4483362458,
          })
      end
   end,
})

-- Initial Refresh
updatePlayerList()

Rayfield:Notify({
   Title = "Success!",
   Content = "CodingFleet Menu Loaded Successfully",
   Duration = 5,
   Image = 4483362458,
})
