    Name = "Bypass Treadmill Velocity Lock",
    CurrentValue = false,
    Flag = "TreadmillBypassToggle",
    Callback = function(Value)
        Config.TreadmillBypass = Value
    end,
})

RunService.Heartbeat:Connect(function()
    if Config.TreadmillBypass then
        local hrp = getRootPart()
        if hrp then
            -- Neutralize forced platform conveyor/treadmill velocity anchoring
            if hrp.AssemblyLinearVelocity.Magnitude < 0.1 and hrp:FindFirstChild("BodyVelocity") then
                hrp.BodyVelocity:Destroy()
            end
        end
    end
end)

