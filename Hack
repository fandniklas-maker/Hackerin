})

SimulatorTab:CreateToggle({
    Name = "Auto-Collect / Claim Trophies",
    CurrentValue = false,
    Flag = "AutoTrophiesToggle",
    Callback = function(Value)
        Config.AutoFarmTrophies = Value
        if Value then
            task.spawn(function()
                while Config.AutoFarmTrophies do
                    -- Scans for workspace collectibles labeled 'Trophy' or 'Win'
                    for _, obj in ipairs(Workspace:GetDescendants()) do
                        if not Config.AutoFarmTrophies then break end
                        if obj:IsA("TouchTransmitter") and (obj.Parent.Name:lower():find("trophy") or obj.Parent.Name:lower():find("win")) then
                            local hrp = getRootPart()
                            if hrp and obj.Parent:IsA("BasePart") then
                                firetouchinterest(hrp, obj.Parent, 0)
                                task.wait(0.01)
                                firetouchinterest(hrp, obj.Parent, 1)
                            end
                        end
                    end
                    task.wait(0.5)
                end
            end)
        end
    end,
})

SimulatorTab:CreateButton({
