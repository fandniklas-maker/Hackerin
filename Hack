local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "CodingFleet | Movement Script",
   LoadingTitle = "Loading Rayfield...",
   LoadingSubtitle = "by CodingFleet",
   ConfigurationSaving = {
      Enabled = true,
      FolderName = "CodingFleetScripts",
      FileName = "MovementHub"
   },
   Discord = {
      Enabled = false,
      Invite = "",
      RememberJoins = true
   },
   KeySystem = false,
})

-- Variables
local Player = game.Players.LocalPlayer
local Character = Player.Character or Player.CharacterAdded:Wait()
local Humanoid = Character:WaitForChild("Humanoid")

local InfiniteJumpEnabled = false
local NoclipEnabled = false
local WalkSpeedValue = 16

-- Tab
local MainTab = Window:CreateTab("Movement", 4483362458) -- Movement Icon

-- Infinite Jump Logic
game:GetService("UserInputService").JumpRequest:Connect(function()
    if InfiniteJumpEnabled then
        Player.Character:FindFirstChildOfClass("Humanoid"):ChangeState("Jumping")
    end
end)

-- Noclip Logic
game:GetService("RunService").Stepped:Connect(function()
    if NoclipEnabled then
        for _, v in pairs(Player.Character:GetDescendants()) do
            if v:IsA("BasePart") and v.CanCollide == true then
                v.CanCollide = false
            end
        end
    end
end)

-- UI Elements
MainTab:CreateToggle({
   Name = "Infinite Jump",
   CurrentValue = false,
   Flag = "InfJump",
   Callback = function(Value)
      InfiniteJumpEnabled = Value
   end,
})

MainTab:CreateToggle({
   Name = "Noclip",
   CurrentValue = false,
   Flag = "Noclip",
   Callback = function(Value)
      NoclipEnabled = Value
      if not Value then
          -- Reset collision when turned off (requires respawn or manual reset usually)
          Rayfield:Notify({
             Title = "Noclip Disabled",
             Content = "Collision will return upon character reset.",
             Duration = 5,
             Image = 4483362458,
          })
      end
   end,
})

MainTab:CreateSlider({
   Name = "WalkSpeed",
   Range = {16, 500},
   Increment = 1,
   Suffix = " Speed",
   CurrentValue = 16,
   Flag = "SpeedSlider",
   Callback = function(Value)
      WalkSpeedValue = Value
      Player.Character.Humanoid.WalkSpeed = Value
   end,
})

-- Keep Speed Applied even after death
Player.CharacterAdded:Connect(function(NewCharacter)
    Character = NewCharacter
    Humanoid = NewCharacter:WaitForChild("Humanoid")
    task.wait(0.5)
    Humanoid.WalkSpeed = WalkSpeedValue
end)

Rayfield:Notify({
   Title = "Script Loaded",
   Content = "CodingFleet Movement Hack is ready!",
   Duration = 5,
   Image = 4483362458,
})
