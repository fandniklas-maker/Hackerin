-- Rayfield UI Library Template
-- This script demonstrates how to create a user interface using the Rayfield library.
-- Note: Functional exploit logic (Aimbot, Godmode, etc.) is not included.

local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "Game Utility Menu",
   LoadingTitle = "Interface Loading...",
   LoadingSubtitle = "by Helper AI",
   ConfigurationSaving = {
      Enabled = true,
      FolderName = "UtilitySettings",
      FileName = "Config"
   }
})

-- Tabs
local CombatTab = Window:CreateTab("Combat", 4483362458)
local MovementTab = Window:CreateTab("Movement", 4483362458)
local VisualsTab = Window:CreateTab("Visuals", 4483362458)

-- Combat Features
CombatTab:CreateToggle({
   Name = "Aimbot",
   CurrentValue = false,
   Flag = "AimbotToggle",
   Callback = function(Value)
      print("Aimbot status: " .. tostring(Value))
      -- Logic for target tracking would be implemented here
   end,
})

CombatTab:CreateSlider({
   Name = "FOV Radius",
   Range = {0, 500},
   Increment = 10,
   Suffix = "px",
   CurrentValue = 100,
   Flag = "FOVSlider",
   Callback = function(Value)
      print("FOV set to: " .. Value)
   end,
})

-- Movement Features
MovementTab:CreateSlider({
   Name = "Walk Speed",
   Range = {16, 200},
   Increment = 1,
   Suffix = "Speed",
   CurrentValue = 16,
   Flag = "SpeedSlider",
   Callback = function(Value)
      local player = game.Players.LocalPlayer
      if player and player.Character and player.Character:FindFirstChild("Humanoid") then
         player.Character.Humanoid.WalkSpeed = Value
      end
   end,
})

MovementTab:CreateToggle({
   Name = "Infinite Jump",
   CurrentValue = false,
   Flag = "InfJump",
   Callback = function(Value)
      print("Infinite Jump status: " .. tostring(Value))
      -- Logic for jumping state detection would be implemented here
   end,
})

-- Visuals / World Features
VisualsTab:CreateToggle({
   Name = "Wall Hack (ESP)",
   CurrentValue = false,
   Flag = "ESP",
   Callback = function(Value)
      print("ESP status: " .. tostring(Value))
      -- Logic for highlighting players through walls would be implemented here
   end,
})

VisualsTab:CreateButton({
   Name = "Noclip (Walk Through Walls)",
   Callback = function()
      print("Noclip activated")
      -- Logic for disabling character collisions would be implemented here
   end,
})

Rayfield:LoadConfiguration()
