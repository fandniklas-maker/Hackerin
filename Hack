local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "Game Utility Interface",
   LoadingTitle = "Loading Utilities...",
   LoadingSubtitle = "Educational Purpose Only",
   ConfigurationSaving = {
      Enabled = true,
      FolderName = "UtilityConfig",
      FileName = "MainGui"
   },
   KeySystem = false
})

local MovementTab = Window:CreateTab("Movement", 4483362458)
local VisualsTab = Window:CreateTab("Visuals", 4483362458)

-- Movement Features
local SpeedSlider = MovementTab:CreateSlider({
   Name = "Walk Speed",
   Range = {16, 100},
   Increment = 1,
   Suffix = " Speed",
   CurrentValue = 16,
   Flag = "SpeedSlider",
   Callback = function(Value)
      if game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild("Humanoid") then
         game.Players.LocalPlayer.Character.Humanoid.WalkSpeed = Value
      end
   end,
})

local JumpSlider = MovementTab:CreateSlider({
   Name = "Jump Power",
   Range = {50, 200},
   Increment = 5,
   Suffix = " Power",
   CurrentValue = 50,
   Flag = "JumpSlider",
   Callback = function(Value)
      if game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild("Humanoid") then
         game.Players.LocalPlayer.Character.Humanoid.JumpPower = Value
      end
   end,
})

-- Visual Features
local FOVSlider = VisualsTab:CreateSlider({
   Name = "Field of View",
   Range = {70, 120},
   Increment = 1,
   Suffix = " FOV",
   CurrentValue = 70,
   Flag = "FOVSlider",
   Callback = function(Value)
      workspace.CurrentCamera.FieldOfView = Value
   end,
})

-- Placeholder for ESP (Educational Logic)
VisualsTab:CreateToggle({
   Name = "Player Highlights (ESP Concept)",
   CurrentValue = false,
   Flag = "ESPToggle",
   Callback = function(Value)
      -- In a real development scenario, this would iterate through players
      -- and add Highlight objects to their characters.
      Rayfield:Notify({
         Title = "Feature Info",
         Content = "ESP logic requires iterating through the Players service and applying Highlights.",
         Duration = 5,
         Image = 4483362458,
      })
   end,
})

Rayfield:Notify({
   Title = "Interface Ready",
   Content = "The utility menu has been loaded successfully.",
   Duration = 5,
   Image = 4483362458,
})
