local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "FleetHub | Multi-Hack",
   LoadingTitle = "Loading FleetHub...",
   LoadingSubtitle = "by CodingFleet",
   ConfigurationSaving = {
      Enabled = true,
      FolderName = "FleetHubConfig",
      FileName = "MainGui"
   },
   KeySystem = false
})

-- Variables
local Player = game.Players.LocalPlayer
local Character = Player.Character or Player.CharacterAdded:Wait()
local Humanoid = Character:WaitForChild("Humanoid")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Camera = game:GetService("Workspace").CurrentCamera

local Flags = {
    Speed = 16,
    JumpPower = 50,
    Noclip = false,
    InfJump = false,
    Aimbot = false,
    Invisible = false
}

-- Update Character Reference on Respawn
Player.CharacterAdded:Connect(function(newChar)
    Character = newChar
    Humanoid = newChar:WaitForChild("Humanoid")
end)

-- Tabs
local MainTab = Window:CreateTab("Player", 4483362458)
local CombatTab = Window:CreateTab("Combat", 4483345998)

-- [ PLAYER TAB ] --

MainTab:CreateSlider({
   Name = "WalkSpeed",
   Range = {16, 300},
   Increment = 1,
   Suffix = "Speed",
   CurrentValue = 16,
   Flag = "WS_Slider",
   Callback = function(Value)
      Flags.Speed = Value
      Humanoid.WalkSpeed = Value
   end,
})

MainTab:CreateSlider({
   Name = "JumpPower",
   Range = {50, 500},
   Increment = 1,
   Suffix = "Power",
   CurrentValue = 50,
   Flag = "JP_Slider",
   Callback = function(Value)
      Flags.JumpPower = Value
      Humanoid.JumpPower = Value
   end,
})

MainTab:CreateToggle({
   Name = "Infinite Jump",
   CurrentValue = false,
   Flag = "InfJump",
   Callback = function(Value)
      Flags.InfJump = Value
   end,
})

MainTab:CreateToggle({
   Name = "Noclip",
   CurrentValue = false,
   Flag = "Noclip",
   Callback = function(Value)
      Flags.Noclip = Value
   end,
})

MainTab:CreateToggle({
   Name = "Invisibility (Local)",
   CurrentValue = false,
   Flag = "Invis",
   Callback = function(Value)
      Flags.Invisible = Value
      for _, part in pairs(Character:GetDescendants()) do
          if part:IsA("BasePart") or part:IsA("Decal") then
              if part.Name ~= "HumanoidRootPart" then
                  part.Transparency = Value and 1 or 0
              end
          end
      end
   end,
})

-- [ COMBAT TAB ] --

CombatTab:CreateToggle({
   Name = "Aimbot (Nearest Part)",
   CurrentValue = false,
   Flag = "Aimbot",
   Callback = function(Value)
      Flags.Aimbot = Value
   end,
})

CombatTab:CreateSection("Settings")
CombatTab:CreateLabel("Aimbot targets the closest player's Head.")

-- [ LOGIC LOOPS ] --

-- Infinite Jump Logic
UserInputService.JumpRequest:Connect(function()
    if Flags.InfJump then
        Humanoid:ChangeState("Jumping")
    end
end)

-- Noclip & Loop Logic
RunService.Stepped:Connect(function()
    -- Maintain Speed/Jump
    if Humanoid then
        Humanoid.WalkSpeed = Flags.Speed
        Humanoid.JumpPower = Flags.JumpPower
    end

    -- Noclip Logic
    if Flags.Noclip then
        for _, part in pairs(Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end

    -- Aimbot Logic
    if Flags.Aimbot then
        local closestPlayer = nil
        local shortestDistance = math.huge

        for _, v in pairs(game.Players:GetPlayers()) do
            if v ~= Player and v.Character and v.Character:FindFirstChild("Head") then
                local pos, onScreen = Camera:WorldToViewportPoint(v.Character.Head.Position)
                if onScreen then
                    local distance = (Vector2.new(pos.X, pos.Y) - Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)).Magnitude
                    if distance < shortestDistance then
                        closestPlayer = v
                        shortestDistance = distance
                    end
                end
            end
        end

        if closestPlayer then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, closestPlayer.Character.Head.Position)
        end
    end
end)

Rayfield:Notify({
   Title = "FleetHub Loaded",
   Content = "Enjoy your hacks!",
   Duration = 5,
   Image = 4483345998,
})
