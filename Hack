CombatTab:CreateSection("Aimbot")

CombatTab:CreateToggle({
   Name = "Enable Aimbot",
   CurrentValue = false,
   Flag = "AimbotToggle",
   Callback = function(Value)
      Vars.Aimbot = Value
   end,
})

-- Aimbot Logic
local Camera = workspace.CurrentCamera
local Mouse = Player:GetMouse()

local function GetClosestPlayer()
    local Closest = nil
    local ShortestDistance = math.huge

    for _, v in pairs(game.Players:GetPlayers()) do
        if v ~= Player and v.Character and v.Character:FindFirstChild("HumanoidRootPart") and v.Character:FindFirstChild("Humanoid").Health > 0 then
            local Pos = Camera:WorldToViewportPoint(v.Character.HumanoidRootPart.Position)
            local Magnitude = (Vector2.new(Pos.X, Pos.Y) - Vector2.new(Mouse.X, Mouse.Y)).Magnitude
            
            if Magnitude < ShortestDistance then
                Closest = v
                ShortestDistance = Magnitude
            end
        end
    end
    return Closest
end

game:GetService("RunService").RenderStepped:Connect(function()
    if Vars.Aimbot then
        local Target = GetClosestPlayer()
        if Target and Target.Character then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, Target.Character.HumanoidRootPart.Position)
        end
    end
end)

--------------------------------------------------------------------------------
-- PLAYERS TAB (Teleport / Bring)
--------------------------------------------------------------------------------

PlayersTab:CreateSection("Player Management")

local SelectedPlayer = ""

PlayersTab:CreateInput({
   Name = "Target Player Name",
   PlaceholderText = "Username (partial)",
   RemoveTextAfterFocusLost = false,
   Callback = function(Text)
      SelectedPlayer = Text
   end,
})

PlayersTab:CreateButton({
   Name = "Teleport To Player",
   Callback = function()
      for _, v in pairs(game.Players:GetPlayers()) do
         if v.Name:lower():find(SelectedPlayer:lower()) and v.Character then
            RootPart.CFrame = v.Character.HumanoidRootPart.CFrame
            Rayfield:Notify({Title = "Success", Content = "Teleported to " .. v.Name, Duration = 3})
            break
         end
      end
   end,
})

PlayersTab:CreateButton({
   Name = "Bring Player (Client-Side/Network)",
   Callback = function()
      for _, v in pairs(game.Players:GetPlayers()) do
         if v.Name:lower():find(SelectedPlayer:lower()) and v.Character then
            -- Note: This usually only works if you have network ownership or a tool
            v.Character.HumanoidRootPart.CFrame = RootPart.CFrame
            Rayfield:Notify({Title = "Attempted", Content = "Tried to bring " .. v.Name, Duration = 3})
            break
         end
      end
   end,
})

Rayfield:LoadConfiguration()
